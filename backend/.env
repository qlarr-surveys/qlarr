# Backend (NestJS) — Phase 0. Copy to backend/.env and adjust.
# Points at the SAME Postgres the Kotlin backend uses (defaults match
# backend-enterprise/src/main/resources/application.yaml local profile).

PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=qlarrdb
DB_USER=qlarr
DB_PASSWORD=password
# Local Postgres has no TLS; RDS requires it (set to true in staging/prod).
DB_SSL=false

# JWT — BASE64 secret, decoded to the HS256 HMAC key. Expirations in ms.
# CHANGE THIS before any real deployment — generate one with:
#   openssl rand -base64 32
JWT_SECRET=changemelaterpleaseorabadthingwillhappen
JWT_ACTIVE_EXPIRATION_MS=3600000
JWT_RESET_EXPIRATION_MS=3600000
JWT_RESET_EXPIRATION_NEW_USERS_MS=2592000000
JWT_REFRESH_EXPIRATION_MS=31536000000

# Public frontend base URL — used to build links in outbound emails
# (password reset).
FRONTEND_URL=http://localhost:3000

# Initial admin (admin@admin.admin) is always seeded on first startup when the
# users table is empty. This is its password — CHANGE IT for any real instance.
SEED_ADMIN_PASSWORD=admin

# SMTP (nodemailer). Defaults target Mailhog for local dev (host localhost,
# port 1025, no auth/TLS) — start it via deploy/docker-compose.local.yml and
# open the web UI at http://localhost:8025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=postmaster@qlarr.com
MAIL_PASSWORD=
MAIL_NAME=Qlarr
MAIL_SMTP_SSL=false
MAIL_SMTP_STARTTLS=false

# Local file storage. Survey files live at {rootFolder}/{surveyId}/{folder}/{file}.
# Point this at a mounted, persistent POSIX filesystem (local volume, NFS, EFS).
# It must be a SHARED mount if you run more than one backend replica. Avoid
# S3-via-FUSE (e.g. s3fs) — it's unreliable for the rename/metadata ops used here.
# In a container use an ABSOLUTE path (relative resolves under root-owned /app)
# on a mount writable by uid 1000 (chown the volume 1000:1000) — else it fails
# fast at boot.
FILE_SYSTEM_ROOT_FOLDER=local-data

# Survey-engine worker pool. The four author-JS-executing ops (validate /
# process / navigate / change_code) run on Piscina worker threads so a runaway
# survey design can be killed (worker terminated after the timeout) without
# blocking or OOM-ing the server. All optional — defaults derived from the host.
# ENGINE_WORKERS defaults true (auto-off under Jest); set false to run in-process.
ENGINE_WORKERS=true
# Max worker threads (default: CPU count - 1). Pinned so it doesn't scale with
# the host's core count — Node reports host cores, not the container's CPU quota.
ENGINE_POOL_SIZE=4
# Hard per-call budget in ms; on expiry the worker is terminated (default 5000).
ENGINE_TIMEOUT_MS=5000
# Per-worker V8 old-space cap in MB; a heap-bomb design crashes its worker, not
# the server (default 512).
ENGINE_MAX_OLD_GEN_MB=512
