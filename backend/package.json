{
  "name": "@qlarr-surveys/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Qlarr backend (NestJS) — single-tenant open-source survey backend.",
  "scripts": {
    "prebuild": "npm --prefix ../shared/design-core ci && npm --prefix ../shared/design-core run build",
    "build": "nest build",
    "start": "TZ=UTC nest start",
    "start:dev": "TZ=UTC nest start --watch",
    "start:debug": "TZ=UTC nest start --debug --watch",
    "start:prod": "TZ=UTC node dist/main.js",
    "test": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:e2e": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:unit": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-unit.json",
    "test:int": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-int.json"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@qlarr/design-core": "file:../shared/design-core",
    "@qlarr/survey-engine": "^0.9.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.2",
    "nodemailer": "^9.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "piscina": "^4.9.4",
    "quickjs-emscripten-core": "^0.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.20",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "body-parser": "^1.20.9",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "glob@10": "^10.5.0",
    "handlebars": "^4.7.10",
    "js-yaml@3": "^3.15.2",
    "js-yaml@4": "^4.3.2",
    "lodash": "^4.18.0",
    "multer": "^2.5.0",
    "picomatch@4": "^4.0.4",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "tmp": "^0.2.7",
    "webpack": "^5.104.1"
  }
}
