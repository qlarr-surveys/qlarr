# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Each app (frontend/, backend/, ai/) has its own .gitignore for build artifacts.
# This root file covers only repo-level concerns.

# OS / editor / tooling
.DS_Store
.claude/

# stray installs (belt-and-suspenders; apps own their own node_modules)
node_modules

# never commit real env files (backend force-tracks its own committed .env)
.env
.env.local
.env.*.local
